<Window x:Class="PhotomotiveStudioMaster.App.ProductionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Production – Import &amp; Vehicle Extraction"
        Width="1320"
        Height="860"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Production" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="EventText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                    <TextBlock x:Name="AiStatusText" Text="Checking local AI..." Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
                <Button Content="AI RUNTIME" Width="115" Margin="0,0,10,0" Click="AiRuntime_Click" />
                <Button Content="REFRESH DRIVES" Width="140" Click="RefreshDrives_Click" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,22,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Source card" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="DriveCombo" Grid.Column="1" DisplayMemberPath="DisplayName" MinHeight="34" />
                <Button Grid.Column="2" Content="SCAN CARD" Width="120" Margin="12,0,0,0" Background="{StaticResource AccentBrush}" Click="ScanCard_Click" />
                <TextBlock x:Name="ScanSummaryText" Grid.Column="3" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <Button x:Name="ImportButton" Grid.Column="4" Content="IMPORT ALL" Width="130" IsEnabled="False" Click="ImportAll_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.70*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.30*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="CARD CONTENTS" FontWeight="Bold" FontSize="12" />
                        <TextBlock x:Name="CandidateCountText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                    </DockPanel>
                    <DataGrid x:Name="CandidateGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="225" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="EVENT PROCESSING QUEUE" FontWeight="Bold" FontSize="12" />
                        <TextBlock x:Name="ImportedCountText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                    </DockPanel>
                    <DataGrid x:Name="ImportedGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="ImportedGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job" Binding="{Binding JobNumber}" Width="105" />
                            <DataGridTextColumn Header="Original" Binding="{Binding OriginalFileName}" Width="*" />
                            <DataGridTemplateColumn Header="Status" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Imported">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Extracting">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Extracted">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Extraction Error">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="ORIGINAL PHOTO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="3,1,0,7" />
                                <Image x:Name="OriginalPreviewImage" Grid.Row="1" Stretch="Uniform" Margin="4" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="3,1,0,7">
                                    <TextBlock Text="EXTRACTED VEHICLE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock x:Name="PreviewStatusText" DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                </DockPanel>
                                <Image x:Name="ExtractedPreviewImage" Grid.Row="1" Stretch="Uniform" Margin="4" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ExtractButton" Grid.Column="0" Content="EXTRACT SELECTED" Width="155" IsEnabled="False" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="ExtractSelected_Click" />
                        <Button Grid.Column="1" Content="OPEN EXTRACTED FOLDER" Width="185" Margin="10,0,0,8" Click="OpenExtractedFolder_Click" />
                        <Button x:Name="PhotoStudioButton" Grid.Column="2" Content="PHOTO STUDIO" Width="145" Margin="10,0,0,8" IsEnabled="False" Click="OpenComposer_Click" />
                        <TextBlock x:Name="SelectedJobHintText" Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,8" Foreground="{StaticResource TextMutedBrush}" Text="Select a job to begin." TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="285" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Insert an SD card, refresh drives, then scan the card." />
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                    <TextBlock x:Name="ExtractionDetailText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ExtractionProgressText" Text="Ready" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="ImportProgressBar" Height="14" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
