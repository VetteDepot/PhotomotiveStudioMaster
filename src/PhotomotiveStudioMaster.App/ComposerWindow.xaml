<Window x:Class="PhotomotiveStudioMaster.App.ComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Composer – 8 x 10 Landscape"
        Width="1420"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Live Composer" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="JobText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9">
                <TextBlock Text="8 × 10 LANDSCAPE  •  3000 × 2400  •  300 PPI" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="285" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="BACKGROUNDS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="BackgroundSearchBox" Grid.Row="1" Margin="0,12,0,12" ToolTip="Search backgrounds" TextChanged="BackgroundSearchBox_TextChanged" />
                    <ListBox x:Name="BackgroundList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="BackgroundList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="120" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#0B0E12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="LIVE PRINT PREVIEW" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="SelectedBackgroundText" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Grid x:Name="PreviewCanvas" Width="800" Height="640" Background="#171C22" ClipToBounds="True">
                            <Image x:Name="BackgroundPreviewImage" Width="800" Height="640" Stretch="UniformToFill" />
                            <Canvas Width="800" Height="640" IsHitTestVisible="False">
                                <Image x:Name="CarPreviewImage" RenderTransformOrigin="0.5,0.5" />
                            </Canvas>
                            <Border BorderBrush="#55FFFFFF" BorderThickness="1" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="VEHICLE PLACEMENT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />

                    <TextBlock Text="Scale" Margin="0,20,0,5" FontWeight="SemiBold" />
                    <DockPanel><TextBlock x:Name="ScaleValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" /><Slider x:Name="ScaleSlider" Minimum="30" Maximum="140" Value="100" TickFrequency="5" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                    <TextBlock Text="Horizontal position" Margin="0,18,0,5" FontWeight="SemiBold" />
                    <DockPanel><TextBlock x:Name="XValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" /><Slider x:Name="XSlider" Minimum="-300" Maximum="300" Value="0" TickFrequency="10" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                    <TextBlock Text="Vertical position" Margin="0,18,0,5" FontWeight="SemiBold" />
                    <DockPanel><TextBlock x:Name="YValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" /><Slider x:Name="YSlider" Minimum="-220" Maximum="220" Value="0" TickFrequency="10" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                    <TextBlock Text="Rotation" Margin="0,18,0,5" FontWeight="SemiBold" />
                    <DockPanel><TextBlock x:Name="RotationValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" /><Slider x:Name="RotationSlider" Minimum="-15" Maximum="15" Value="0" TickFrequency="1" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                    <Button Content="RESET PLACEMENT" Margin="0,26,0,8" Click="ResetPlacement_Click" />

                    <Border Background="{StaticResource PanelAltBrush}" CornerRadius="9" Padding="13" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="LAYERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="● Vehicle cutout" Margin="0,9,0,0" />
                            <TextBlock Text="● Background" Margin="0,6,0,0" />
                            <TextBlock Text="Shadow layer arrives in Module 2.3." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,16,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="OPEN COMPOSITES FOLDER" Width="190" Margin="0,0,10,0" Click="OpenCompositesFolder_Click" />
                    <Button Content="SAVE 8×10 COMPOSITE" Width="190" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="SaveComposite_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="ComposerStatusText" Text="Choose a background to begin." />
                    <TextBlock x:Name="ComposerDetailText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
