<Window x:Class="PhotomotiveStudioMaster.App.ComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photomotive Automotive Photo Studio"
        Width="1580"
        Height="940"
        MinWidth="1240"
        MinHeight="780"
        WindowStartupLocation="CenterOwner"
        Loaded="ComposerWindow_Loaded"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Automotive Photo Studio" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="JobText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="AUTO POSITION" Width="130" Margin="0,0,8,0" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="AutoPosition_Click" />
                <Button Content="AUTO SHADOW" Width="120" Margin="0,0,8,0" Click="AutoShadow_Click" />
                <Button Content="AUTO HALO REPAIR" Width="140" Margin="0,0,8,0" Click="AutoHaloRepair_Click" />
                <Button Content="SAVE PROJECT" Width="120" Margin="0,0,10,0" Click="SaveProject_Click" />
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="8 × 10 LANDSCAPE  •  3000 × 2400  •  300 PPI" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="Drag = move  •  Wheel = scale  •  Space = before/after" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="305" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="BACKGROUNDS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="BackgroundCountText" DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <TextBox x:Name="BackgroundSearchBox" Grid.Row="1" Margin="0,10,0,8" ToolTip="Search backgrounds" TextChanged="BackgroundSearchBox_TextChanged" />
                    <ComboBox x:Name="CategoryFilter" Grid.Row="2" Margin="0,0,0,9" SelectionChanged="CategoryFilter_SelectionChanged" />
                    <ListBox x:Name="BackgroundList" Grid.Row="3" Background="Transparent" BorderThickness="0" SelectionChanged="BackgroundList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="96" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="5" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        </Border>
                                        <Grid Grid.Row="1" Margin="1,6,1,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding FavoriteGlyph}" Foreground="{StaticResource WarningBrush}" Margin="6,0,0,0" />
                                        </Grid>
                                        <TextBlock Grid.Row="2" Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="1,2,1,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#080B0F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LIVE PHOTO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border x:Name="CompareBadge" Background="{StaticResource AccentBrush}" CornerRadius="5" Padding="7,2" Margin="9,-2,0,0" Visibility="Collapsed">
                                <TextBlock Text="ORIGINAL" FontSize="9" FontWeight="Bold" />
                            </Border>
                            <Border x:Name="HaloBadge" Background="#B0006DFF" CornerRadius="5" Padding="7,2" Margin="7,-2,0,0" Visibility="Collapsed">
                                <TextBlock Text="HALO OVERLAY" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SelectedBackgroundText" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Grid x:Name="PreviewCanvas" Width="800" Height="640" Background="#171C22" ClipToBounds="True" PreviewMouseWheel="PreviewCanvas_PreviewMouseWheel">
                            <Image x:Name="BackgroundPreviewImage" Width="800" Height="640" Stretch="UniformToFill" />
                            <Canvas x:Name="ShadowCanvas" Width="800" Height="640" IsHitTestVisible="False">
                                <Ellipse x:Name="GroundShadowEllipse" Fill="#D9000000" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Effect><BlurEffect x:Name="GroundShadowBlur" Radius="18" /></Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="LeftContactShadow" Fill="#E6000000">
                                    <Ellipse.Effect><BlurEffect Radius="5" /></Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="RightContactShadow" Fill="#E6000000">
                                    <Ellipse.Effect><BlurEffect Radius="5" /></Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                            <Canvas x:Name="VehicleCanvas" Width="800" Height="640">
                                <Image x:Name="CarPreviewImage" RenderTransformOrigin="0.5,0.5" Cursor="SizeAll"
                                       MouseLeftButtonDown="CarPreviewImage_MouseLeftButtonDown"
                                       MouseMove="CarPreviewImage_MouseMove"
                                       MouseLeftButtonUp="CarPreviewImage_MouseLeftButtonUp" />
                                <Image x:Name="HaloOverlayImage"
                                       IsHitTestVisible="False"
                                       Stretch="Fill"
                                       RenderTransformOrigin="0.5,0.5"
                                       Visibility="Collapsed"
                                       Width="{Binding ActualWidth, ElementName=CarPreviewImage}"
                                       Height="{Binding ActualHeight, ElementName=CarPreviewImage}"
                                       Canvas.Left="{Binding Path=(Canvas.Left), ElementName=CarPreviewImage}"
                                       Canvas.Top="{Binding Path=(Canvas.Top), ElementName=CarPreviewImage}"
                                       RenderTransform="{Binding RenderTransform, ElementName=CarPreviewImage}" />
                            </Canvas>
                            <Image x:Name="OriginalPreviewImage" Width="800" Height="640" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Border BorderBrush="#44FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PLACEMENT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="The car is cropped to its visible bounds for accurate placement." Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,10" />

                        <UniformGrid Columns="2" Margin="0,0,0,3">
                            <Button Content="AUTO FIT" Margin="0,0,4,6" Click="AutoFit_Click" />
                            <Button Content="RESET" Margin="4,0,0,6" Click="ResetPlacement_Click" />
                        </UniformGrid>

                        <TextBlock Text="Scale" FontWeight="SemiBold" Margin="0,7,0,2" />
                        <DockPanel><TextBlock x:Name="ScaleValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="ScaleSlider" Minimum="30" Maximum="175" Value="100" TickFrequency="5" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Horizontal" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <DockPanel><TextBlock x:Name="XValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="XSlider" Minimum="-360" Maximum="360" Value="0" TickFrequency="10" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Vertical" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <DockPanel><TextBlock x:Name="YValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="YSlider" Minimum="-280" Maximum="280" Value="90" TickFrequency="10" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Rotation" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <DockPanel><TextBlock x:Name="RotationValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="RotationSlider" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                        <Separator Margin="0,12,0,10" />
                        <DockPanel>
                            <TextBlock Text="SMART SHADOW" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <CheckBox x:Name="ShadowEnabledCheckBox" DockPanel.Dock="Right" Content="ON" IsChecked="True" VerticalAlignment="Center" Checked="ShadowControl_Changed" Unchecked="ShadowControl_Changed" />
                        </DockPanel>
                        <UniformGrid Columns="2" Margin="0,8,0,3">
                            <Button Content="AUTO SHADOW" Margin="0,0,4,6" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="AutoShadow_Click" />
                            <Button Content="RESET SHADOW" Margin="4,0,0,6" Click="ResetShadow_Click" />
                        </UniformGrid>

                        <TextBlock Text="Opacity" FontWeight="SemiBold" Margin="0,6,0,2" />
                        <DockPanel><TextBlock x:Name="ShadowOpacityValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="80" Value="34" ValueChanged="ShadowSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Softness" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="ShadowSoftnessValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="ShadowSoftnessSlider" Minimum="2" Maximum="45" Value="20" ValueChanged="ShadowSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Width" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="ShadowWidthValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="ShadowWidthSlider" Minimum="35" Maximum="135" Value="88" ValueChanged="ShadowSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Length" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="ShadowLengthValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="ShadowLengthSlider" Minimum="15" Maximum="100" Value="45" ValueChanged="ShadowSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Angle" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="ShadowAngleValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="ShadowAngleSlider" Minimum="-60" Maximum="60" Value="0" ValueChanged="ShadowSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Horizontal offset" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="ShadowXValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="ShadowXSlider" Minimum="-180" Maximum="180" Value="0" ValueChanged="ShadowSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Vertical offset" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="ShadowYValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="ShadowYSlider" Minimum="-100" Maximum="140" Value="0" ValueChanged="ShadowSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Tire contact" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="ContactShadowValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="ContactShadowSlider" Minimum="0" Maximum="100" Value="58" ValueChanged="ShadowSlider_ValueChanged" /></DockPanel>

                        <Separator Margin="0,13,0,10" />
                        <DockPanel>
                            <TextBlock Text="HALO INSPECTOR" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <CheckBox x:Name="HaloOverlayCheckBox" DockPanel.Dock="Right" Content="OVERLAY" VerticalAlignment="Center" Checked="HaloOverlay_Changed" Unchecked="HaloOverlay_Changed" />
                        </DockPanel>
                        <TextBlock Text="Non-destructive edge cleanup for white/dark fringes and color spill." Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,8" />
                        <UniformGrid Columns="2" Margin="0,0,0,3">
                            <Button Content="AUTO REPAIR" Margin="0,0,4,6" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="AutoHaloRepair_Click" />
                            <Button Content="RESET EDGES" Margin="4,0,0,6" Click="ResetHalo_Click" />
                        </UniformGrid>

                        <TextBlock Text="Edge feather" FontWeight="SemiBold" Margin="0,6,0,2" />
                        <DockPanel><TextBlock x:Name="HaloFeatherValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="HaloFeatherSlider" Minimum="0" Maximum="4" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="HaloSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Mask expand / contract" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="HaloMaskValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="HaloMaskSlider" Minimum="-4" Maximum="4" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="HaloSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Halo removal" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="HaloRemovalValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="HaloRemovalSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="HaloSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Color decontamination" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="HaloDecontamValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="HaloDecontamSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="HaloSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Fine detail recovery" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <DockPanel><TextBlock x:Name="HaloDetailValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="HaloDetailSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="HaloSlider_ValueChanged" /></DockPanel>

                        <Button x:Name="CompareButton" Content="COMPARE ORIGINAL" Margin="0,14,0,7" Click="CompareButton_Click" />
                        <Button Content="SAVE PROJECT" Margin="0,0,0,7" Click="SaveProject_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="OPEN FINISHED FOLDER" Width="165" Margin="0,0,8,0" Click="OpenFinishedFolder_Click" />
                    <Button Content="SAVE JPG" Width="98" Margin="0,0,8,0" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="SaveJpg_Click" />
                    <Button Content="SAVE PNG" Width="98" Margin="0,0,8,0" Click="SavePng_Click" />
                    <Button Content="SAVE TIFF" Width="98" Click="SaveTiff_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="ComposerStatusText" Text="Choose a background to begin." />
                    <TextBlock x:Name="ComposerDetailText" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>