<Window x:Class="PhotomotiveStudioMaster.App.ComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automotive Photo Studio – 8 x 10 Landscape"
        Width="1500"
        Height="920"
        MinWidth="1220"
        MinHeight="780"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Automotive Photo Studio" FontSize="31" FontWeight="SemiBold" />
                <TextBlock x:Name="JobText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9">
                <StackPanel>
                    <TextBlock Text="8 × 10 LANDSCAPE  •  3000 × 2400  •  300 PPI" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Spacebar = Original / Finished" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="305" />
            </Grid.ColumnDefinitions>

            <!-- Background browser -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="BACKGROUNDS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="BackgroundSearchBox" Grid.Row="1" Margin="0,11,0,9" ToolTip="Search backgrounds" TextChanged="BackgroundSearchBox_TextChanged" />
                    <ComboBox x:Name="CategoryFilter" Grid.Row="2" Margin="0,0,0,10" SelectionChanged="CategoryFilter_SelectionChanged" />
                    <ListBox x:Name="BackgroundList" Grid.Row="3" Background="Transparent" BorderThickness="0" SelectionChanged="BackgroundList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,9" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="118" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="6" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        </Border>
                                        <Grid Grid.Row="1" Margin="1,7,1,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding FavoriteGlyph}" Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock Grid.Row="2" Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="1,3,1,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Live photo preview -->
            <Border Grid.Column="2" Background="#090C10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LIVE FINISHED PHOTO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border x:Name="CompareBadge" Background="{StaticResource AccentBrush}" CornerRadius="5" Padding="8,3" Margin="10,-3,0,0" Visibility="Collapsed">
                                <TextBlock Text="ORIGINAL" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SelectedBackgroundText" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>

                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Grid x:Name="PreviewCanvas" Width="800" Height="640" Background="#171C22" ClipToBounds="True"
                              PreviewMouseWheel="PreviewCanvas_PreviewMouseWheel">
                            <Image x:Name="BackgroundPreviewImage" Width="800" Height="640" Stretch="UniformToFill" />
                            <Canvas x:Name="VehicleCanvas" Width="800" Height="640">
                                <Image x:Name="CarPreviewImage" RenderTransformOrigin="0.5,0.5" Cursor="SizeAll"
                                       MouseLeftButtonDown="CarPreviewImage_MouseLeftButtonDown"
                                       MouseMove="CarPreviewImage_MouseMove"
                                       MouseLeftButtonUp="CarPreviewImage_MouseLeftButtonUp" />
                            </Canvas>
                            <Image x:Name="OriginalPreviewImage" Width="800" Height="640" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Border BorderBrush="#55FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Adjustment tools -->
            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PHOTO ADJUSTMENTS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Drag the car directly. Use the mouse wheel over the preview to resize it." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,15" />

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="AUTO POSITION" Margin="0,0,5,8" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="AutoPosition_Click" />
                            <Button Content="AUTO FIT" Margin="5,0,0,8" Click="AutoFit_Click" />
                        </UniformGrid>

                        <TextBlock Text="Scale" FontWeight="SemiBold" Margin="0,9,0,4" />
                        <DockPanel><TextBlock x:Name="ScaleValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="ScaleSlider" Minimum="30" Maximum="150" Value="100" TickFrequency="5" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Horizontal position" FontWeight="SemiBold" Margin="0,15,0,4" />
                        <DockPanel><TextBlock x:Name="XValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="XSlider" Minimum="-320" Maximum="320" Value="0" TickFrequency="10" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Vertical position" FontWeight="SemiBold" Margin="0,15,0,4" />
                        <DockPanel><TextBlock x:Name="YValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="YSlider" Minimum="-240" Maximum="240" Value="90" TickFrequency="10" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                        <TextBlock Text="Rotation" FontWeight="SemiBold" Margin="0,15,0,4" />
                        <DockPanel><TextBlock x:Name="RotationValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" /><Slider x:Name="RotationSlider" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                        <Button Content="RESET PLACEMENT" Margin="0,19,0,8" Click="ResetPlacement_Click" />
                        <Button x:Name="CompareButton" Content="COMPARE ORIGINAL" Margin="0,0,0,8" Click="CompareButton_Click" />

                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="9" Padding="13" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="REALISM TOOLS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="Shadow Engine" Margin="0,9,0,0" />
                                <TextBlock Text="Coming next: contact shadow, angle, length, width, opacity, and softness." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="Lighting Match" Margin="0,12,0,0" />
                                <TextBlock Text="Planned after the shadow engine to blend the car naturally into each scene." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,14,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="OPEN FINISHED FOLDER" Width="175" Margin="0,0,9,0" Click="OpenFinishedFolder_Click" />
                    <Button Content="SAVE JPG" Width="105" Margin="0,0,9,0" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="SaveJpg_Click" />
                    <Button Content="SAVE PNG" Width="105" Margin="0,0,9,0" Click="SavePng_Click" />
                    <Button Content="SAVE TIFF" Width="105" Click="SaveTiff_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="ComposerStatusText" Text="Choose a background to begin." />
                    <TextBlock x:Name="ComposerDetailText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>