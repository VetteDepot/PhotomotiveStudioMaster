<Window x:Class="PhotomotiveStudioMaster.App.ShowboardComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Showboard Composer – 16 x 24 Portrait"
        Width="1500" Height="940" MinWidth="1220" MinHeight="780"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Showboard Composer" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="JobText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9">
                <TextBlock Text="16 × 24 PORTRAIT  •  4800 × 7200  •  300 PPI" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="BACKGROUNDS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="BackgroundSearchBox" Grid.Row="1" Margin="0,11,0,11" ToolTip="Search backgrounds" TextChanged="BackgroundSearchBox_TextChanged" />
                    <ListBox x:Name="BackgroundList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="BackgroundList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="105"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#090C10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,9">
                        <TextBlock Text="SHOWBOARD CANVAS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="SelectedBackgroundText" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Grid x:Name="PreviewCanvas" Width="480" Height="720" Background="#171C22" ClipToBounds="True">
                            <Image x:Name="BackgroundPreviewImage" Width="480" Height="720" Stretch="UniformToFill" />
                            <Canvas Width="480" Height="720">
                                <Image x:Name="CarPreviewImage" RenderTransformOrigin="0.5,0.5" Cursor="SizeAll"
                                       MouseLeftButtonDown="CarPreviewImage_MouseLeftButtonDown"
                                       MouseMove="CarPreviewImage_MouseMove"
                                       MouseLeftButtonUp="CarPreviewImage_MouseLeftButtonUp" />
                            </Canvas>
                            <Border BorderBrush="#55FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17">
                <StackPanel>
                    <TextBlock Text="VEHICLE LAYER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Drag the vehicle directly on the canvas or use the controls below." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,13" />

                    <TextBlock Text="Scale" FontWeight="SemiBold" />
                    <DockPanel Margin="0,5,0,0"><TextBlock x:Name="ScaleValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" /><Slider x:Name="ScaleSlider" Minimum="25" Maximum="180" Value="100" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                    <TextBlock Text="Horizontal" Margin="0,15,0,0" FontWeight="SemiBold" />
                    <DockPanel Margin="0,5,0,0"><TextBlock x:Name="XValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" /><Slider x:Name="XSlider" Minimum="-220" Maximum="220" Value="0" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                    <TextBlock Text="Vertical" Margin="0,15,0,0" FontWeight="SemiBold" />
                    <DockPanel Margin="0,5,0,0"><TextBlock x:Name="YValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" /><Slider x:Name="YSlider" Minimum="-300" Maximum="300" Value="80" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                    <TextBlock Text="Rotation" Margin="0,15,0,0" FontWeight="SemiBold" />
                    <DockPanel Margin="0,5,0,0"><TextBlock x:Name="RotationValueText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" /><Slider x:Name="RotationSlider" Minimum="-20" Maximum="20" Value="0" ValueChanged="PlacementSlider_ValueChanged" /></DockPanel>

                    <Button Content="RESET VEHICLE" Margin="0,20,0,8" Click="ResetPlacement_Click" />

                    <Border Background="{StaticResource PanelAltBrush}" CornerRadius="9" Padding="13" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="LAYERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="5" Padding="8" Margin="0,9,0,0"><TextBlock Text="Vehicle cutout" FontWeight="SemiBold" /></Border>
                            <Border Background="{StaticResource InputBrush}" CornerRadius="5" Padding="8" Margin="0,6,0,0"><TextBlock Text="Background" /></Border>
                            <TextBlock Text="Text, spec panels, inset photos and shadows are coming in the next Module 3 checkpoints." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,14,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="OPEN SHOWBOARDS FOLDER" Width="195" Margin="0,0,10,0" Click="OpenShowboardsFolder_Click" />
                    <Button Content="EXPORT 16×24 PNG" Width="175" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="ExportShowboard_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Choose a background to begin." />
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>