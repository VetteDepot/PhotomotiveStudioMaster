<Window x:Class="PhotomotiveStudioMaster.App.BackgroundManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background Manager"
        Width="1480"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Background Manager" FontSize="31" FontWeight="SemiBold" />
                <TextBlock Text="Browse, rate, organize, and prepare premium automotive backgrounds for the Composer."
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="OPEN LIBRARY FOLDER" Width="170" Margin="0,0,10,8" Click="OpenLibraryFolder_Click" />
                <Button Content="IMPORT BACKGROUNDS" Width="180" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="ImportBackgrounds_Click" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" ToolTip="Search background name, category, or tags" TextChanged="FilterChanged" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LIBRARY" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="StatsText" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="410" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,5,0,10" />
                    <ListBox x:Name="CategoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="CategoryList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,2,4,10">
                        <TextBlock Text="BACKGROUND LIBRARY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="VisibleCountText" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <ListBox x:Name="BackgroundList" Grid.Row="1" SelectionChanged="BackgroundList_SelectionChanged"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="228" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="138" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="7" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        </Border>
                                        <Grid Grid.Row="1" Margin="2,9,2,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding FavoriteGlyph}" Foreground="{StaticResource WarningBrush}" FontSize="19" Margin="8,-2,0,0" />
                                        </Grid>
                                        <Grid Grid.Row="2" Margin="2,4,2,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding ResolutionDisplay}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                        </Grid>
                                        <Grid Grid.Row="3" Margin="2,5,2,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RatingDisplay}" Foreground="{StaticResource WarningBrush}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding UsageDisplay}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="265" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="BACKGROUND DETAILS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border Grid.Row="1" Background="{StaticResource InputBrush}" CornerRadius="9" Margin="0,11,0,14" ClipToBounds="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </Border>

                    <TextBlock x:Name="NoSelectionText" Grid.Row="2" Text="Select a background to preview, rate, favorite, and edit its metadata."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                        <StackPanel x:Name="MetadataPanel" Visibility="Collapsed">
                            <TextBlock x:Name="SelectedNameText" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock x:Name="SelectedSummaryText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,18" />

                            <TextBlock Text="Name" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="NameBox" />

                            <TextBlock Text="Category" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,14,0,6" />
                            <ComboBox x:Name="CategoryBox"
                                      IsEditable="False"
                                      IsTextSearchEnabled="True"
                                      ToolTip="Choose the library category for this background" />

                            <TextBlock Text="Tags" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,14,0,6" />
                            <TextBox x:Name="TagsBox" ToolTip="Example: garage, night, blue, Corvette" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="125" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rating" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox x:Name="RatingBox" SelectionChanged="RatingBox_SelectionChanged">
                                        <ComboBoxItem Content="Unrated" Tag="0" />
                                        <ComboBoxItem Content="★" Tag="1" />
                                        <ComboBoxItem Content="★★" Tag="2" />
                                        <ComboBoxItem Content="★★★" Tag="3" />
                                        <ComboBoxItem Content="★★★★" Tag="4" />
                                        <ComboBoxItem Content="★★★★★" Tag="5" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="Usage" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Border Height="38" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9">
                                        <TextBlock x:Name="UseCountText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="ResolutionText" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="AssetInfoText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <WrapPanel x:Name="ActionPanel" Grid.Row="4" Visibility="Collapsed" Margin="0,16,0,0">
                        <Button Content="SAVE DETAILS" Width="130" MinHeight="42" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="SaveDetails_Click" />
                        <Button x:Name="FavoriteButton" Content="ADD FAVORITE" Width="130" MinHeight="42" Margin="8,0,0,8" Click="Favorite_Click" />
                        <Button Content="OPEN" Width="82" MinHeight="42" Margin="8,0,0,8" Click="OpenBackground_Click" />
                        <Button Content="DELETE" Width="82" MinHeight="42" Margin="8,0,0,8" Click="Delete_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Import JPG, PNG, or TIFF backgrounds, or drag files anywhere onto this window." Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock DockPanel.Dock="Right" Text="Module 2.1.5 • Premium Asset Browser" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
