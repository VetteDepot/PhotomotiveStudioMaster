<Window x:Class="PhotomotiveStudioMaster.App.BackgroundManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background Manager"
        Width="1320"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Background Manager" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Manage premium automotive backgrounds for the Composer." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="OPEN LIBRARY FOLDER" Width="170" Margin="0,0,10,8" Click="OpenLibraryFolder_Click" />
                <Button Content="IMPORT BACKGROUNDS" Width="175" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="ImportBackgrounds_Click" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,20,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" ToolTip="Search name, category, or tags" TextChanged="FilterChanged" />
                <ComboBox x:Name="CategoryFilter" Grid.Column="1" Margin="12,0,0,0" SelectionChanged="FilterChanged" />
                <TextBlock x:Name="StatsText" Grid.Column="2" Margin="18,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,12">
                        <TextBlock Text="LIBRARY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="VisibleCountText" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <ListBox x:Name="BackgroundList" Grid.Row="1" SelectionChanged="BackgroundList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="190" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8">
                                    <StackPanel>
                                        <Border Height="112" Background="{StaticResource InputBrush}" CornerRadius="6" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        </Border>
                                        <Grid Margin="2,9,2,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding FavoriteGlyph}" Foreground="{StaticResource WarningBrush}" FontSize="16" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="2,3,2,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="230" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="BACKGROUND DETAILS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border Grid.Row="1" Background="{StaticResource InputBrush}" CornerRadius="8" Margin="0,12,0,16" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </Border>

                    <TextBlock x:Name="NoSelectionText" Grid.Row="2" Text="Select a background to preview and edit its metadata." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                    <StackPanel x:Name="MetadataPanel" Grid.Row="3" Visibility="Collapsed">
                        <TextBlock Text="Name" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <TextBox x:Name="NameBox" />
                        <TextBlock Text="Category" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
                        <TextBox x:Name="CategoryBox" />
                        <TextBlock Text="Tags" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
                        <TextBox x:Name="TagsBox" ToolTip="Example: garage, night, blue, Corvette" />
                        <TextBlock x:Name="AssetInfoText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>

                    <WrapPanel x:Name="ActionPanel" Grid.Row="4" Visibility="Collapsed" Margin="0,16,0,0">
                        <Button Content="SAVE DETAILS" Width="125" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="SaveDetails_Click" />
                        <Button x:Name="FavoriteButton" Content="ADD FAVORITE" Width="130" Margin="8,0,0,8" Click="Favorite_Click" />
                        <Button Content="DELETE" Width="90" Margin="8,0,0,8" Click="Delete_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Text="Import JPG, PNG, or TIFF backgrounds, or drag files anywhere onto this window." Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
