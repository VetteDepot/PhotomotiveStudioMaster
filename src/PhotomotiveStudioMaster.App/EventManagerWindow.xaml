<Window x:Class="PhotomotiveStudioMaster.App.EventManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Manager"
        Width="920"
        Height="620"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Event Manager" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Open a saved event or create a new one." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <Button Content="NEW EVENT" Width="130" DockPanel.Dock="Right" Background="{StaticResource AccentBrush}" Click="NewEvent_Click" />
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,24,0,24">
            <DataGrid x:Name="EventsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding EventCode}" Width="90" />
                    <DataGridTextColumn Header="Event" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Date" Binding="{Binding DisplayDate}" Width="130" />
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="190" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="2">
            <Button Content="CLOSE" Width="110" IsCancel="True" DockPanel.Dock="Left" />
            <Button Content="RESUME SELECTED EVENT" Width="190" Background="{StaticResource AccentBrush}" DockPanel.Dock="Right" Click="ResumeEvent_Click" />
        </DockPanel>
    </Grid>
</Window>
