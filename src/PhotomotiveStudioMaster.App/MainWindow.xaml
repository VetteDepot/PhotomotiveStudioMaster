<Window x:Class="PhotomotiveStudioMaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photomotive Studio Master – Event Edition"
        Width="1280"
        Height="800"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="PHOTOMOTIVE" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="STUDIO MASTER" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="EVENT EDITION" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Button Content="Dashboard" HorizontalContentAlignment="Left" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" />
                    <Button Content="Event Manager" HorizontalContentAlignment="Left" Click="EventManager_Click" />
                    <Button Content="Production" HorizontalContentAlignment="Left" Click="Production_Click" />
                    <Button Content="Background Manager" HorizontalContentAlignment="Left" Click="BackgroundManager_Click" />
                    <Button Content="Orders" HorizontalContentAlignment="Left" IsEnabled="False" />
                    <Button Content="Print Queue" HorizontalContentAlignment="Left" IsEnabled="False" />
                    <Button Content="Archive" HorizontalContentAlignment="Left" IsEnabled="False" />
                    <Button Content="Settings" HorizontalContentAlignment="Left" IsEnabled="False" />
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="● Automotive Photo Studio" Foreground="{StaticResource SuccessBrush}" Margin="0,7,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="Version 0.7" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30" Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Dashboard" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Photomotive Studio Master – Event Edition" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" FontSize="14" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="ActiveEventText" Text="No active event" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                </Border>
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,28,0,22">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,12,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Cars Today" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" /><TextBlock Text="0" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" /></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,12,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Images Ready" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" /><TextBlock Text="0" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" /></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,12,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Prints Sold" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" /><TextBlock Text="0" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" /></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Revenue" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" /><TextBlock Text="$0.00" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" /></StackPanel></Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" MaxWidth="650">
                        <TextBlock Text="Automotive Photo Studio" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Turn an ordinary car-show photograph into a polished automotive image. Extract the car, choose a realistic background, position it naturally, compare against the original, and save an 8×10 finished photo as JPG, PNG, or TIFF."
                                   TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,26" LineHeight="24" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="OPEN PRODUCTION" Width="190" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="Production_Click" />
                            <Button Content="BACKGROUND MANAGER" Width="200" Margin="12,0,0,8" Click="BackgroundManager_Click" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" CornerRadius="12" Padding="22" Margin="30,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MODULE 3 • PHOTO STUDIO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="✓  Managed background browser" Margin="0,18,0,0" FontSize="14" />
                            <TextBlock Text="✓  Direct drag placement" Margin="0,11,0,0" FontSize="14" />
                            <TextBlock Text="✓  Mouse-wheel vehicle scaling" Margin="0,11,0,0" FontSize="14" />
                            <TextBlock Text="✓  Auto Fit + Auto Position" Margin="0,11,0,0" FontSize="14" />
                            <TextBlock Text="✓  Original / finished comparison" Margin="0,11,0,0" FontSize="14" />
                            <TextBlock Text="✓  JPG / PNG / TIFF export" Margin="0,11,0,0" FontSize="14" />
                            <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="12" Margin="0,22,0,0">
                                <TextBlock Text="Next: realistic contact shadow engine" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
