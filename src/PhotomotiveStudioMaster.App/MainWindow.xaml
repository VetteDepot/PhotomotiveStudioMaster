<Window x:Class="PhotomotiveStudioMaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photomotive Studio Master – Event Edition"
        Width="1280"
        Height="800"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1B2026" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="PHOTOMOTIVE" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="STUDIO MASTER" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="EVENT EDITION" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Button Content="Dashboard" HorizontalContentAlignment="Left" Background="{StaticResource AccentBrush}" />
                    <Button Content="Event Manager" HorizontalContentAlignment="Left" Click="EventManager_Click" />
                    <Button Content="Production" HorizontalContentAlignment="Left" Click="Production_Click" />
                    <Button Content="Orders" HorizontalContentAlignment="Left" IsEnabled="False" />
                    <Button Content="Print Queue" HorizontalContentAlignment="Left" IsEnabled="False" />
                    <Button Content="Backgrounds" HorizontalContentAlignment="Left" IsEnabled="False" />
                    <Button Content="Archive" HorizontalContentAlignment="Left" IsEnabled="False" />
                    <Button Content="Settings" HorizontalContentAlignment="Left" IsEnabled="False" />
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="● SD Card Import Ready" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="Version 0.3" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Dashboard" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Photomotive Studio Master – Event Edition" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14,8">
                    <TextBlock x:Name="ActiveEventText" Text="No active event" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,28,0,22">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="Cars Today" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock Text="0" FontSize="32" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="Images Ready" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock Text="0" FontSize="32" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="Prints Sold" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock Text="0" FontSize="32" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="Revenue" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock Text="$0.00" FontSize="32" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel></Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="28">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" MaxWidth="600">
                        <TextBlock Text="SD Card Import Engine" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Insert a photographer card, scan supported images, copy originals into the active event, checksum-verify every file, skip duplicates, and create numbered event jobs." TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,24" LineHeight="23" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="OPEN PRODUCTION" Width="190" Background="{StaticResource AccentBrush}" Click="Production_Click" />
                            <Button Content="EVENT MANAGER" Width="160" Margin="12,0,0,0" Click="EventManager_Click" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" CornerRadius="10" Padding="20" Margin="28,0,0,0">
                        <StackPanel>
                            <TextBlock Text="SPRINT 3 STATUS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="✓ Removable drive detection" Margin="0,16,0,0" />
                            <TextBlock Text="✓ Image file scanning" Margin="0,9,0,0" />
                            <TextBlock Text="✓ SHA-256 duplicate detection" Margin="0,9,0,0" />
                            <TextBlock Text="✓ Verified file copying" Margin="0,9,0,0" />
                            <TextBlock Text="✓ Event job numbering" Margin="0,9,0,0" />
                            <TextBlock Text="Next: thumbnails + AI queue" Margin="0,22,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
